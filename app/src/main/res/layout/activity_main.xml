<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/rootColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status / Controls Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Idle"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLogPath"
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:layout_marginTop="6dp"
                    android:text="Log: (none)"
                    android:textSize="@dimen/text_size_caption" />



                <TextView
                    android:id="@+id/tvSelectedDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Selected device: (none)"
                    android:textSize="@dimen/text_size_caption"
                    android:typeface="monospace" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectDevice"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Select Device"
                    android:textSize="@dimen/text_size_body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetry"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_body"
                        android:layout_weight="1"
                        android:text="Connect" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDisconnect"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textSize="@dimen/text_size_body"
                        android:layout_weight="1"
                        android:text="Disconnect" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swRssiViz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RSSI Visualizer" />

                <com.example.ringdemo.RssiPlotView
                    android:id="@+id/rssiPlot"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp" />




                <TextView
                    android:id="@+id/tvRssiGain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Gain: 1.00"
                    android:textSize="@dimen/text_size_caption"
                    android:typeface="monospace" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderRssiGain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="2.0"
                    android:stepSize="0.05"
                    android:value="1.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swAutoInterp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/text_size_body"
                        android:text="Auto smoothing" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSound"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sound: OFF"
                        android:textSize="@dimen/text_size_body"
                        />


                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoadWav"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Load Wav"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/tvWavStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="WAV sample: (none)"
                    android:textSize="@dimen/text_size_caption"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/tvRssiTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="WAV trigger RSSI: -65 dBm"
                    android:textSize="@dimen/text_size_caption"
                    android:typeface="monospace" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderRssiTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="-95"
                    android:valueTo="-35"
                    android:stepSize="1"
                    android:value="-65" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swInterpolateWav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Interpolate WAV (repeat while above cutoff)" />

                <TextView
                    android:id="@+id/tvWavRepeatMultiplier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WAV repeat delay multiplier: 1x"
                    android:textSize="@dimen/text_size_caption"
                    android:typeface="monospace" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderWavRepeatMultiplier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1"
                    android:valueTo="5"
                    android:stepSize="1"
                    android:value="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tone Axis Controls"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_section" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swAxisX"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Axis X" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swAxisY"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Axis Y" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swAxisZ"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Axis Z" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRangeX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="X range: 120 - 880 Hz"
                    android:textSize="@dimen/text_size_caption"
                    android:typeface="monospace" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/sliderRangeX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="20"
                    android:valueTo="2000"
                    android:stepSize="10" />

                <TextView
                    android:id="@+id/tvRangeY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Y range: 120 - 880 Hz"
                    android:textSize="@dimen/text_size_caption"
                    android:typeface="monospace" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/sliderRangeY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="20"
                    android:valueTo="2000"
                    android:stepSize="10" />

                <TextView
                    android:id="@+id/tvRangeZ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Z range: 120 - 880 Hz"
                    android:textSize="@dimen/text_size_caption"
                    android:typeface="monospace" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/sliderRangeZ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="20"
                    android:valueTo="2000"
                    android:stepSize="10" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderInterp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:valueFrom="0.15"
                    android:valueTo="1.5"
                    android:stepSize="0.05"
                    android:value="1.5" />

                <TextView
                    android:id="@+id/tvInterp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Smoothing: 1.50 s"
                    android:typeface="monospace"
                    android:textSize="@dimen/text_size_caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live Values Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvLiveTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Live Values"
                    android:textSize="@dimen/text_size_section"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="rot: (---, ---, ---)"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/tvG"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="g: (+0.000, +0.000, +0.000)"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/tvRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="rate: --- pkt/s"
                    android:typeface="monospace" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tail Log Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="402dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tail Log"
                    android:textSize="@dimen/text_size_section"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTail"
                    android:layout_width="match_parent"
                    android:layout_height="345dp"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:textSize="@dimen/text_size_caption"
                    android:typeface="monospace" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
